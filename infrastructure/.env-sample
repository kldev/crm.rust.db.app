# Copy to .env and set your own values. .env is git-ignored.
# Superuser of the local PostgreSQL 18 (used only by db-init to create the roles and the database).
POSTGRES_PASSWORD=
CRM_DB_NAME=crm
CRM_DB_MIGRATOR_USER=crm_migrator
CRM_DB_MIGRATOR_PASSWORD=
CRM_DB_APP_USER=crm_app
CRM_DB_APP_PASSWORD=

# First administrator, created on start when the database has no ADMIN.
CRM_ADMIN_LOGIN=admin
CRM_ADMIN_PASSWORD=

# Host ports (bound to 127.0.0.1).
CRM_HTTP_PORT=8088
CRM_DB_HOST_PORT=15432

# Desk attachments (RustFS, S3): keys of the local bucket; any 8+ characters.
CRM_S3_ACCESS_KEY=
CRM_S3_SECRET_KEY=
CRM_S3_BUCKET=crm-attachments

# Application
CRM_DB_POOL_SIZE=30
CRM_LOGIN_MAX_FAILED=5
CRM_LOGIN_LOCK_MINUTES=15
# One-click login as any seeded user on the login page (local only; never on a shared server).
CRM_DEV_LOGIN=true
# Service desk: tickets the public form accepts per minute (whole application).
CRM_DESK_PUBLIC_REPORTS_PER_MINUTE=30

# Seed (./start.sh --seed). Password of all perf.* users (perf.admin.0001, perf.manager.0001, perf.sales.0001, ...).
CRM_SEED_PASSWORD=
CRM_SEED_CLIENTS=5000000
CRM_SEED_ADMINS=10
CRM_SEED_MANAGERS=490
CRM_SEED_SALES=4500
CRM_SEED_TEAM_SIZE=5
CRM_SEED_PROJECTS=5000000
CRM_SEED_COMMENTS=2000000
CRM_SEED_RANDOM_SEED=42
CRM_SEED_BATCH_SIZE=500000
# Service desk seed: agents, people and generated tickets (idempotent). DESK_ONLY=true for an already seeded CRM.
CRM_SEED_DESK_TICKETS=200
CRM_SEED_DESK_ONLY=false
