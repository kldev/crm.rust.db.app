{
	"$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
	"vcs": { "enabled": false, "clientKind": "git", "useIgnoreFile": false },
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**/src/**/*",
			"**/index.html",
			"**/vite.config.ts",
			"**/orval.config.ts",
			"!**/src/routeTree.gen.ts",
			"!**/src/api/endpoints",
			"!**/src/api/models"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 100,
		"attributePosition": "auto"
	},
	"assist": { "enabled": true, "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": { "noDescendingSpecificity": "warn" },
			"suspicious": { "noArrayIndexKey": "off" }
		}
	},
	"css": { "parser": { "tailwindDirectives": true } },
	"javascript": { "formatter": { "quoteStyle": "double" } }
}
